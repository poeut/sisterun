# =========================================================
# SisterRun — variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# =========================================================

# ---- Base de données (SQLite local pour le prototype) ----
DATABASE_URL="file:./dev.db"

# ---- NextAuth (Auth.js v5) ----
# Générer un secret : openssl rand -base64 32
AUTH_SECRET="change-me-in-production-please-use-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ---- Mapbox (optionnel — fallback Leaflet/OpenStreetMap si vide) ----
# Récupérer un token gratuit sur https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ---- Pusher Channels (optionnel — fallback polling si vide) ----
# Créer une app gratuite sur https://pusher.com/
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="eu"
PUSHER_APP_ID=""
PUSHER_SECRET=""

# ---- Mode démo / debug ----
# Si "true", l'app log les notifications email au lieu de les envoyer
EMAIL_MOCK="true"
